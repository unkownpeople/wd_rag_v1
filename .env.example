# 复制为项目根目录的 .env 后填写本地密钥。
# .env 已被 .gitignore 排除，禁止提交真实密钥。

APP_NAME=Annual Report RAG API
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8001

QDRANT_COLLECTION=annual_report_v1_single_company
# 以下路径不填写时，代码使用项目根目录内的默认位置；只有目录结构变化时才取消注释并修改。
# QDRANT_PATH=./xianlian
# CHUNK_DIR=./data/processed/annual_reports/v1_single_company_chunks
# EMBEDDING_MODEL_PATH=./models/bge-m3-embedding/model_quantized.onnx
# EMBEDDING_TOKENIZER_PATH=./models/bge-m3

EMBEDDING_MAX_LENGTH=8192
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_CONTEXT_CHARS=64000
NO_ANSWER_DENSE_THRESHOLD=0.50

LLM_ENABLED=true
LLM_PROVIDER=deepseek
# 使用同一个 Key 时只填写 DEEPSEEK_API_KEY；Planner 和 Answer 使用不同 Key 时填写下面两个分角色变量。
DEEPSEEK_API_KEY=
DEEPSEEK_PLANNER_API_KEY=
DEEPSEEK_ANSWER_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PLANNER_MODEL=deepseek-v4-flash
DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
PLANNER_ENABLED=true
PLANNER_MAX_TOKENS=4000
